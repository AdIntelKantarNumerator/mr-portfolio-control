# Open WebUI settings for "Ask Yaara". Nothing secret lives here.
#
# Read by deploy/open-webui/chat-up.ps1 (Azure) and run-local.sh (a local
# test). The secrets it also needs come from Key Vault in Azure and from a
# file outside the repository locally; README.md beside this file lists them.
#
# Pinned to Open WebUI 0.11.4, the version these names were checked against on
# 1 October 2026 (backend/open_webui/env.py and config.py). A newer image may
# rename one, and a renamed setting is silently ignored.

# --- Configuration comes from here, every start ------------------------------
# Off, so these values win on every restart. On, Open WebUI copies them into its
# database the first time and ignores them after that, and an admin clicking in
# its settings screen would quietly override this file.
ENABLE_PERSISTENT_CONFIG=False

# --- Yaara is the only model -------------------------------------------------
# The portfolio's relay lists one model, "yaara". Ollama is off, so Open WebUI
# does not go looking for a local model server, and nobody can add their own
# connection from the browser.
ENABLE_OLLAMA_API=False
ENABLE_DIRECT_CONNECTIONS=False
ENABLE_EVALUATION_ARENA_MODELS=False
DEFAULT_MODELS=yaara

# "Yaara (Open WebUI)" in the title. Open WebUI appends the suffix itself, and
# its licence forbids removing that branding above 50 users, so it stays.
WEBUI_NAME=Yaara

# Everyone signed in sees her. Open WebUI otherwise shows a model only to
# admins until someone writes an access rule for it, and with one model and
# nothing private in its settings there is nothing for a rule to protect.
BYPASS_MODEL_ACCESS_CONTROL=True

# --- Signing in --------------------------------------------------------------
# Google only, the same as the portfolio: no Open WebUI passwords, no sign-up
# form. A first Google sign-in creates the account as an ordinary user rather
# than one waiting for an admin to approve it, because only the allowed
# domains (OAUTH_ALLOWED_DOMAINS, set by the deploy from the portfolio's
# AUTH_ALLOWED_DOMAINS) can get that far. The very first person to sign in
# becomes the Open WebUI admin, so that should be whoever looks after it.
ENABLE_OAUTH_SIGNUP=True
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=True
ENABLE_SIGNUP=False
ENABLE_LOGIN_FORM=False
ENABLE_PASSWORD_AUTH=False
DEFAULT_USER_ROLE=user

# --- Who is asking -----------------------------------------------------------
# Every request to the portfolio carries the signed-in person as a signed
# token (FORWARD_USER_INFO_HEADER_JWT_SECRET, a secret). The portfolio verifies
# it and refuses plain headers.
ENABLE_FORWARD_USER_INFO_HEADERS=True

# --- Nothing runs behind her back --------------------------------------------
# Open WebUI normally asks the chat model to title chats, tag them, suggest
# follow-ups and autocomplete. Every one of those would be a full Yaara turn,
# with tools, for a question nobody asked. Off.
ENABLE_TITLE_GENERATION=False
ENABLE_TAGS_GENERATION=False
ENABLE_FOLLOW_UP_GENERATION=False
ENABLE_AUTOCOMPLETE_GENERATION=False
ENABLE_SEARCH_QUERY_GENERATION=False
ENABLE_RETRIEVAL_QUERY_GENERATION=False

# --- Features this chat does not offer ---------------------------------------
# She reads the portfolio and her sources herself; Open WebUI's own web search,
# document retrieval, code execution and image generation would answer
# alongside her and look like her doing it.
ENABLE_WEB_SEARCH=False
ENABLE_IMAGE_GENERATION=False
ENABLE_CODE_INTERPRETER=False
ENABLE_CODE_EXECUTION=False
BYPASS_EMBEDDING_AND_RETRIEVAL=True
ENABLE_COMMUNITY_SHARING=False
USER_PERMISSIONS_CHAT_FILE_UPLOAD=False
USER_PERMISSIONS_CHAT_WEB_UPLOAD=False
# A system prompt typed in the chat settings is dropped by the portfolio
# anyway (lib/yaara-chat.ts); hiding the box stops people thinking it works.
USER_PERMISSIONS_CHAT_SYSTEM_PROMPT=False
USER_PERMISSIONS_CHAT_PARAMS=False
USER_PERMISSIONS_CHAT_MULTIPLE_MODELS=False
USER_PERMISSIONS_CHAT_ALLOW_PUBLIC_SHARING=False

# --- No downloads at start, no phoning home -----------------------------------
OFFLINE_MODE=True
ENABLE_VERSION_UPDATE_CHECK=False
RAG_EMBEDDING_MODEL_AUTO_UPDATE=False

# Some of what Yaara does is slow: an Engineering Weekly rebuild reads three
# hosts. The portfolio waits up to 20 minutes; this must not give up first.
AIOHTTP_CLIENT_TIMEOUT=1500
