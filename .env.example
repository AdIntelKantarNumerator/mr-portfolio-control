# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL unset for the prototype: it runs an embedded Postgres
# (PGlite) out of ./.data, with nothing to install.
#
# To move to a real Postgres, set the connection string. Nothing else changes —
# same schema, same migrations, same queries.
#
# DATABASE_URL="postgresql://pcr:pcr@localhost:5432/pcr"
# DATABASE_SSL=require        # verify the server certificate (Azure, RDS, most
#                             # managed providers — no extra config needed)
# DATABASE_SSL=no-verify      # ONLY for a self-signed cert on an internal server
# DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Linear
# ---------------------------------------------------------------------------
# Personal API key: Linear → Settings → Security & access → Personal API keys.
# Read-only is enough; this tool never writes to Linear.
LINEAR_API_KEY=

# Webhook signing secret: Linear → Settings → API → Webhooks.
# Point the webhook at  https://<your-host>/api/webhooks/linear
# and subscribe to Projects, Initiatives and Project milestones.
LINEAR_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Google sign-in
# ---------------------------------------------------------------------------
# Leave GOOGLE_CLIENT_ID blank and the app runs with no sign-in at all, which
# keeps local evaluation zero-config. In production that combination is refused
# rather than quietly serving an unauthenticated app.
#
# To set it up, in Google Cloud Console:
#   1. APIs & Services -> OAuth consent screen -> Internal (Workspace only)
#   2. Credentials -> Create credentials -> OAuth client ID -> Web application
#   3. Authorised redirect URI:  <APP_URL>/api/auth/callback
#      e.g. http://localhost:3000/api/auth/callback for local testing
#   4. Copy the client ID and secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated Workspace domains allowed to sign in. REQUIRED when Google
# sign-in is on: without it, any Google account on the internet could get in.
#
# List EVERY domain in the Workspace, not just the one people currently use for
# email. A company that has been renamed usually keeps the original domain as
# the Workspace account's primary and adds the new one as a secondary, so some
# accounts can still sit under the old domain. Missing it out locks those
# people out with no obvious pattern.
AUTH_ALLOWED_DOMAINS=mediaradar.com,magazineradar.com

# Optional: pre-filter Google's account chooser to one domain. Leave it UNSET
# on a multi-domain Workspace — hinting one domain makes sign-in fail for
# everyone on the others. It is not a security control; the allow-list above is.
# AUTH_GOOGLE_HD=mediaradar.com

# Signs the session cookie. At least 32 characters. Generate with:
#   openssl rand -hex 32
# Changing it signs everyone out, which is also how you force that.
AUTH_SECRET=

# Session lifetime in seconds. Default is one week.
# AUTH_SESSION_MAX_AGE=604800

# Only for a deployment genuinely behind something else that authenticates
# users (an identity-aware proxy). Lets production start with no Google client.
# AUTH_ALLOW_ANONYMOUS=true

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# Shared secret for POST /api/sync/* and /api/digest. Generate with:
#   openssl rand -hex 32
# If this is unset, those endpoints refuse to run in production.
SYNC_TOKEN=

# The app's own base URL. Used to build the Google redirect URI and the link in
# the Slack digest. Must match the redirect URI registered in Google Cloud.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google Sheets (optional) — for workstreams that are not in Linear
# ---------------------------------------------------------------------------
# A JSON array of sheet sources. Each needs an id, a label, the sheet URL and a
# mapping from your column headers onto project fields. Only `name` is
# required; unmapped columns are ignored.
#
# SHEETS_SOURCES='[{"id":"bau","label":"360 BAU tracker","url":"https://docs.google.com/spreadsheets/d/XXXX/edit?gid=0","mapping":{"key":"ID","name":"Workstream","status":"Status","startDate":"Start","targetDate":"Target","initiative":"Initiative","progress":"% complete","notes":"Notes"}}]'
#
# The sheet must be readable by link. For a private sheet, supply a token
# instead (any OAuth token with drive.readonly scope):
# GOOGLE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Slack (optional)
# ---------------------------------------------------------------------------
# Slash-command intake. Create a slash command pointing at
#   https://<your-host>/api/slack/intake
# and copy the app's signing secret here.
SLACK_SIGNING_SECRET=

# Incoming webhook for the weekly digest.
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Conversation briefs (optional)
# ---------------------------------------------------------------------------
# Summarises attached meeting transcripts, Slack excerpts and documents into a
# few traceable bullets on the initiative and project views.
#
# Leave unset and everything else still works: conversations can be attached
# and stored, and the screens say plainly that no summariser is configured.
#
# Three providers are supported. Set ONE. The prompt, the citation rules and
# the parsing are identical across all three, so a brief means the same thing
# whichever answered — the choice is about where transcripts go, not quality.
#
# When more than one is set, the order of preference is Azure, then Gemini,
# then Anthropic, on the principle that the option keeping data inside
# infrastructure you already control should not lose by accident.
# SUMMARISER_PROVIDER=azure-openai   # force one: azure-openai | gemini | anthropic

# --- Azure OpenAI: transcripts never leave your tenant ----------------------
# az cognitiveservices account create -n <name> -g <rg> -l eastus --kind OpenAI \
#   --sku s0 --custom-domain <name> --yes
# az cognitiveservices account deployment create -n <name> -g <rg> \
#   --deployment-name briefs --model-name gpt-4o --model-version 2024-11-20 \
#   --model-format OpenAI --sku-name Standard --sku-capacity 1
#
# AZURE_OPENAI_DEPLOYMENT is the DEPLOYMENT name you chose, not the model name.
# Getting that wrong is a 404 that reads like the resource does not exist.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- Google Gemini ----------------------------------------------------------
# A key from Google AI Studio. Transcripts are sent to Google.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Anthropic --------------------------------------------------------------
# A key from platform.claude.com. Transcripts are sent to Anthropic.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
